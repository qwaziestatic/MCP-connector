{
  "name": "mcp-connector",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Dagim Tsegaye",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwaziestatic/MCP-connector.git"
  },
  "private": true,
  "description": "Secure desktop integration platform for Windows and Linux, exposing local app contexts and cloud APIs as MCP tools.",
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mcp-connector/desktop",
    "build": "npm run build --workspace=@mcp-connector/core && npm run build --workspace=@mcp-connector/desktop && npm run build --workspace=apps/vscode-extension",
    "package:win": "npm run package:win --workspace=@mcp-connector/desktop",
    "package:linux": "npm run package:linux --workspace=@mcp-connector/desktop",
    "typecheck": "npm run build --workspace=@mcp-connector/core && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@mcp-connector/core",
    "prisma:migrate": "npm run prisma:migrate --workspace=@mcp-connector/core",
    "build:vscode": "npm run build --workspace=apps/vscode-extension",
    "package:vscode": "npm run package --workspace=apps/vscode-extension",
    "package:skill": "node scripts/package-skill.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3"
  }
}
