{
  "name": "@mcp-connector/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Dagim Tsegaye",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwaziestatic/MCP-connector.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "description": "Secure desktop connector for local and cloud MCP tools.",
  "main": "out/main/main.js",
  "desktopName": "mcp-connector.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run verify-build",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:win:signed": "npm run build && electron-builder --win --config electron-builder.signed.yml --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify-build": "node scripts/verify-build.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "database:migrate": "npm run prisma:migrate --workspace=@mcp-connector/core"
  },
  "dependencies": {
    "@mcp-connector/core": "0.1.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@tanstack/react-query": "^5.62.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.16.0",
    "globals": "^15.15.0",
    "prisma": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.mcpconnector.desktop",
    "productName": "MCP Connector",
    "copyright": "Copyright © 2026 Dagim Tsegaye",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.map",
      {
        "from": "../../node_modules/.prisma/client",
        "to": "node_modules/.prisma/client"
      }
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MCP-Connector-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MCP Connector",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "mcp-connector",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MCP-Connector-${version}-${arch}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    },
    "deb": {
      "maintainer": "Dagim Tsegaye <139397610+qwaziestatic@users.noreply.github.com>",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    }
  }
}
